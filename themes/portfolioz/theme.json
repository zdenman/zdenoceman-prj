{
    "$schema": "https://schemas.wp.org/trunk/theme.json",
    "version": 2,
    "settings": {
        "appearanceTools": true,
        "color": {
            "defaultPalette": false,
            "palette": [
                { "slug": "m-white", "color": "rgb(255,255,255)", "name": "Modster White" },
                { "slug": "m-gray-100", "color": "rgb(243 244 246)", "name": "Modster Gray 100" },
                { "slug": "m-gray-200", "color": "rgb(229 231 235)", "name": "Modster Gray 200" },
                { "slug": "m-gray-300", "color": "rgb(209 213 219)", "name": "Modster Gray 300" },
                { "slug": "m-gray-400", "color": "rgb(156 163 175)", "name": "Modster Gray 400" },
                { "slug": "m-gray-500", "color": "rgb(107 114 128)", "name": "Modster Gray 500" },
                { "slug": "m-gray-600", "color": "rgb(75 85 99)", "name": "Modster Gray 600" },
                { "slug": "m-gray-700", "color": "rgb(55 65 81)", "name": "Modster Gray 700" },
                { "slug": "m-gray-800", "color": "rgb(31 41 55)", "name": "Modster Gray 800" },
                { "slug": "m-gray-900", "color": "rgb(17 24 39)", "name": "Modster Gray 900" },
                { "slug": "m-primary", "color": "rgb(239 68 68)", "name": "Modster Primary" },
                { "slug": "m-accent", "color": "rgb(67 56 202)", "name": "Modster Accent" },
                { "slug": "m-success", "color": "rgb(52 211 153)", "name": "Modster Success" },
                { "slug": "m-info", "color": "rgb(96 165 250)", "name": "Modster Info" },
                { "slug": "m-warning", "color": "rgb(251 146 60)", "name": "Modster Warning" },
                { "slug": "m-danger", "color": "rgb(236 72 153)", "name": "Modster Danger" }
            ],
            "background": true,
            "text": true,
            "link": false,
            "custom": true,
            "duotone": [
                {"slug": "m-pink-sunset", "colors": ["#11245e", "#dc4379"], "name": "Modster Pink Sunset"}
            ],
            "defaultGradients": false,
            "gradients": [
                {
                    "slug": "m-summer-dog", "name": "Modster Summer Dog", "gradient": "linear-gradient(#a8ff78, #78ffd6)"
                }
            ]
        },
        "blocks": {
            "core/site-title": {
                "color": {
                    "defaultPalette": false,
                    "palette": [
                        { "slug": "m-primary", "color": "#ef4444", "name": "Modster Primary" }
                    ],
                    "link": true,
                    "custom": true,
                    "gradients": [],
                    "customGradient": false
                },
                "typography": {
                    "fontFamilies": [
                        { 
                            "fontFamily": "Pacifico, sans-serif",
                            "slug": "m-pacifico",
                            "name": "Modster Pacifico"
                        }
                    ]
                }
            },
            "core/cover":{
                "color": {
                    "duotone": [],
                    "customDuotone": false
                }
            },
            "core/preformatted": {
                "typography": {
                    "fontSizes": [],
                    "customFontSize": false
                }
            }
        },
        "border": {
            "color": true,
            "radius": true,
            "style": true,
            "width": true
        },
        "typography": {
            "fontFamilies": [
                { 
                    "fontFamily": "Rubik, sans-serif",
                    "slug": "m-rubik",
                    "name": "Modster Rubik"
                }
            ],
            "fontSizes": [
                { "slug": "small", "size": "0.75rem", "name": "Small" },
                { "slug": "medium", "size": "1.25rem", "name": "Medium" },
                { "slug": "large", "size": "2.25rem", "name": "Large" },
                { "slug": "x-large", "size": "3rem", "name": "X-Large" },
                { "slug": "gigantic", "size": "3.75rem", "name": "Gigantic" }
            ],
            "lineHeight": true,
            "dropCap": true,
            "fontWeight": true,
            "fontStyle": true,
            "textTransform": true,
            "letterSpacing": true,
            "textDecoration": true
        },
        "layout": {
            "contentSize": "800px",
            "wideSize": "1100px"
        },
        "spacing": {
            "margin": true,
            "padding": true,
            "units": [
                "px", "rem", "vh", "vw", "%"
            ],
            "blockGap": true
        }
    },
    "styles": {
        "color": {
            "text": "var(--wp--preset--color--m-gray-700)",
            "background": "var(--wp--preset--color--m-white)"
        },
        "blocks": {
            "core/button": {
                "color": {
                    "gradient": "var(--wp--preset--gradient--m-summer-dog)"
                }
            },
            "core/pullquote": {
                "border": {
                    "width": "2px",
                    "style": "solid",
                    "radius": "5px",
                    "color": "var(--wp--preset--color--m-primary)"
                }
            },
            "core/site-title": {
                "typography": {
                    "fontFamily": "var(--wp--preset--font-family--m-pacifico)"
                }
            }
        },
        "elements": {
            "link": {
                "color": {
                    "text": "var(--wp--preset--color--m-primary)"
                }
            }
        },
        "typography": {
            "fontFamily": "var(--wp--preset--font-family--m-rubik)",
            "fontSize": "16px",
            "fontStyle": "normal",
            "fontWeight": "normal",
            "lineHeight": "inherit",
            "textDecoration": "none",
            "textTransform": "none"
        },
        "spacing": {
            "margin": {
                "top": "0px",
                "bottom": "0px",
                "left": "0px",
                "right": "0px"
            },
            "padding": {
                "top": "0px",
                "bottom": "0px",
                "left": "0px",
                "right": "0px"
            },
            "blockGap": "4rem"
        }
    },
    "customTemplates": [
        {
            "name": "full-width-page",
            "title": "Full Width Page",
            "postTypes": [
                "page"
            ]
        }
    ]
}